#!/bin/bash
# Auto-generated backup script for {{ app_name }}
# Created by Ansible on {{ ansible_date_time.iso8601 }}

BACKUP_DIR="{{ backup_dir }}"
DB_USER="{{ db_user }}"
DB_PASSWORD="{{ db_password }}"
DB_NAME="{{ db_name }}"
RETENTION_DAYS={{ backup_retention_days }}
DATE=$(date +%Y%m%d_%H%M%S)

# Create backup
mysqldump -u $DB_USER -p$DB_PASSWORD $DB_NAME > $BACKUP_DIR/{{ app_name }}_backup_$DATE.sql

# Compress
gzip $BACKUP_DIR/{{ app_name }}_backup_$DATE.sql

# Remove old backups
find $BACKUP_DIR -name "{{ app_name }}_backup_*.sql.gz" -mtime +$RETENTION_DAYS -delete

echo "Backup completed: {{ app_name }}_backup_$DATE.sql.gz"
